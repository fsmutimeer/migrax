# Ensure consistent line endings in version control
* text=auto
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
bin/migrax text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary

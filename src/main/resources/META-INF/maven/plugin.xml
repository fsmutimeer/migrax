<plugin>
  <name>Migrax Maven Plugin</name>
  <description>Generates and applies database schema migrations for the current Maven project.</description>
  <groupId>io.migrax</groupId>
  <artifactId>migrax</artifactId>
  <version>0.1.0</version>
  <goalPrefix>migrax</goalPrefix>
  <isolatedRealm>false</isolatedRealm>
  <inheritedByDefault>true</inheritedByDefault>
  <mojos>
    <mojo>
      <goal>generate</goal>
      <description>Generates a SQL migration by diffing current JPA entities against the saved snapshot.</description>
      <requiresDependencyResolution>runtime</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <threadSafe>true</threadSafe>
      <implementation>io.migrax.plugin.GenerateMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <executePhase>compile</executePhase>
      <parameters>
        <parameter>
          <name>allowDestructive</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Whether destructive schema changes may be generated.</description>
        </parameter>
        <parameter>
          <name>basePackage</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Base package containing JPA entities.</description>
        </parameter>
        <parameter>
          <name>directory</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>Project directory containing the entity snapshot.</description>
        </parameter>
        <parameter>
          <name>locations</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Migration directory location; defaults to classpath:db/migration.</description>
        </parameter>
        <parameter>
          <name>password</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database password override.</description>
        </parameter>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <editable>false</editable>
          <description>The Maven project being inspected.</description>
        </parameter>
        <parameter>
          <name>url</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>JDBC URL override.</description>
        </parameter>
        <parameter>
          <name>user</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database username override.</description>
        </parameter>
      </parameters>
      <configuration>
        <allowDestructive implementation="boolean" default-value="false">${migrax.allowDestructive}</allowDestructive>
        <basePackage implementation="java.lang.String" default-value="${project.groupId}">${migrax.package}</basePackage>
        <directory implementation="java.io.File" default-value="${project.basedir}">${migrax.dir}</directory>
        <locations implementation="java.lang.String">${migrax.locations}</locations>
        <password implementation="java.lang.String">${migrax.password}</password>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <url implementation="java.lang.String">${migrax.url}</url>
        <user implementation="java.lang.String">${migrax.user}</user>
      </configuration>
    </mojo>
    <mojo>
      <goal>migrate</goal>
      <description>Applies sorted SQL files from the configured migration location.</description>
      <requiresDependencyResolution>runtime</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <threadSafe>true</threadSafe>
      <implementation>io.migrax.plugin.MigrateMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <parameters>
        <parameter>
          <name>directory</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>Project directory.</description>
        </parameter>
        <parameter>
          <name>locations</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Migration directory location; defaults to classpath:db/migration.</description>
        </parameter>
        <parameter>
          <name>password</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database password.</description>
        </parameter>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <editable>false</editable>
          <description>The Maven project being migrated.</description>
        </parameter>
        <parameter>
          <name>resume</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Explicitly retry failed migrations marked resume-safe.</description>
        </parameter>
        <parameter>
          <name>url</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>JDBC URL.</description>
        </parameter>
        <parameter>
          <name>user</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database username.</description>
        </parameter>
      </parameters>
      <configuration>
        <directory implementation="java.io.File" default-value="${project.basedir}">${migrax.dir}</directory>
        <locations implementation="java.lang.String">${migrax.locations}</locations>
        <password implementation="java.lang.String">${migrax.password}</password>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <resume implementation="boolean" default-value="false">${migrax.resume}</resume>
        <url implementation="java.lang.String">${migrax.url}</url>
        <user implementation="java.lang.String">${migrax.user}</user>
      </configuration>
    </mojo>
    <mojo>
      <goal>repair</goal>
      <description>Repairs history after an operator verifies a failed migration's database state.</description>
      <requiresDependencyResolution>runtime</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <threadSafe>true</threadSafe>
      <implementation>io.migrax.plugin.RepairMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <parameters>
        <parameter>
          <name>action</name>
          <type>java.lang.String</type>
          <required>true</required>
          <editable>true</editable>
          <description>applied if fully completed; retry only after restoring pre-migration state.</description>
        </parameter>
        <parameter>
          <name>confirm</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Explicit operator confirmation after database inspection.</description>
        </parameter>
        <parameter>
          <name>directory</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>Project directory.</description>
        </parameter>
        <parameter>
          <name>locations</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Migration directory location; defaults to classpath:db/migration.</description>
        </parameter>
        <parameter>
          <name>password</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database password override.</description>
        </parameter>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <editable>false</editable>
          <description>The Maven project being repaired.</description>
        </parameter>
        <parameter>
          <name>url</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>JDBC URL override.</description>
        </parameter>
        <parameter>
          <name>user</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Database username override.</description>
        </parameter>
        <parameter>
          <name>version</name>
          <type>java.lang.String</type>
          <required>true</required>
          <editable>true</editable>
          <description>Failed migration filename, including .sql.</description>
        </parameter>
      </parameters>
      <configuration>
        <action implementation="java.lang.String">${migrax.action}</action>
        <confirm implementation="boolean" default-value="false">${migrax.confirm}</confirm>
        <directory implementation="java.io.File" default-value="${project.basedir}">${migrax.dir}</directory>
        <locations implementation="java.lang.String">${migrax.locations}</locations>
        <password implementation="java.lang.String">${migrax.password}</password>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <url implementation="java.lang.String">${migrax.url}</url>
        <user implementation="java.lang.String">${migrax.user}</user>
        <version implementation="java.lang.String">${migrax.version}</version>
      </configuration>
    </mojo>
  </mojos>
</plugin>
